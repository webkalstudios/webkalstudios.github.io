# Cloudflare Pages : durée de mémorisation chez les visiteurs.
# Les polices ne changent jamais ; styles.css et site.js changent de ?v= à chaque modification.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=86400
/*.css
  Cache-Control: public, max-age=600
/*.js
  Cache-Control: public, max-age=600
/llms.txt
  Content-Type: text/plain; charset=utf-8
